---
import { cn } from '@/utils'

interface Props {
  certificateName: string
  organization: string
  date: string
  credentialsLink?: string
  class?: string
}

const { certificateName, organization, date, credentialsLink, class: className } = Astro.props
---

<div
  class={cn(
    'flex flex-row gap-8 p-4 justify-between w-full items-start border-1  rounded-3 text-muted-foreground line-height-5',
    className
  )}
>
  <div class='flex flex-col gap-2 w-80%'>
    <h3 class='my-0'>{certificateName}</h3>
    <p class='my-0'>{organization} • {date}</p>
  </div>
  <a class='pt-1 text-end' href={credentialsLink}>View Credential</a>
</div>
