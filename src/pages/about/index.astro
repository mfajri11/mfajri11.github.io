---
import { Button, Spoiler } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import { CertificationCard, Experience, Icon, SkillLayout } from '@/components/custom'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'experience', text: 'Experience' },
  { depth: 2, slug: 'certification', text: 'Certification' },
  { depth: 2, slug: 'skill', text: 'Skill' }
]
---

<PageLayout title='About' {headings}>
  <p>Sofware Engineer</p>
  <p>
    I'm a software engineer with around two years of experience, mostly working on maintaining and
    improving large codebases in a national tech company and the banking industry. I've worked with
    Go and Python, and have built things like secure SSO flows, payment features, and OTP services.
    I try to write clean, maintainable code and enjoy learning about architecture, microservices,
    and database indexing.
  </p>
  <p>
    My favorite saying: <Spoiler>Did you drink your water today?</Spoiler>
  </p>

  <Button title='Email Me' class='w-fit' href=`mailto:${config.email}` variant='button'>
    <Icon name='email' slot='before' />
  </Button>

  {/* Education */}
  <h2 id='education'>Education</h2>
  <div class='flex gap-2 w-full'>
    <div class='w-7/10 font-bold'>Bachelor of Computer Science</div>
    <div class='flex-row gap-2 w-full items-end'>
      <div class='w-full text-end'>University Singaperbangsa of Karawang,</div>
      <div class='w-full text-end font-light'>Aug 2018 - Jan 2023</div>
    </div>
  </div>
  <ul class='w-70%'>
    <li>
      <b>Coursework: </b>Basic Computer Architecture, Comparison of Learning Algorithms, etc.
    </li>
    <li>
      <b>Final Project: </b>Sundanese Script Classification Using Transfer Learning with
      EfficientNet
    </li>
  </ul>

  {/* Experiences */}
  <h2 id='experience'>Experience</h2>
  <Experience experiences={config.experiences} />

  <!-- {/* Cerification */} -->
  <h2 id='certification'>Certification</h2>
  <CertificationCard
    certificateName='Speaker at Skillvul X GDSC USU'
    organization='skillvul'
    credentialsLink='https://drive.google.com/file/d/1j_v74OYid37IgxXqjqlMD5zBf_TLFgn1/view?pli=1'
    date='Feb 2024'
    class='my-4'
  />
  <CertificationCard
    certificateName='BRILiaN Internship Bootcamp'
    organization='PT Bank Rakyat Indonesia'
    credentialsLink='https://drive.google.com/file/d/1baE7K1to1pLRqqgWop75T9v6A6RObJPH/view'
    date='July 2023'
    class='my-4'
  />
  <CertificationCard
    certificateName='Generasi gigih Internship program at Tokopedia'
    organization='Tokopedia'
    credentialsLink='https://drive.google.com/file/d/1baE7K1to1pLRqqgWop75T9v6A6RObJPH/view'
    date='July 2022'
    class='my-4'
  />
  <CertificationCard
    certificateName='English for Business & Software Engineering Beginner 2'
    organization='Cakap'
    credentialsLink='https://drive.google.com/file/d/1cVWj1ExM_Fuv8-bJUtrTrzQG41xY5OeR/view'
    date='July 2022'
    class='my-4'
  />
  <CertificationCard
    certificateName='Scientific Computing with Python by FreeCodeCamp'
    organization='FreeCodeCamp'
    credentialsLink='https://www.freecodecamp.org/certification/mfajri_11/scientific-computing-with-python-v7'
    date='March 2021'
    class='my-4'
  />

  <h2 id='skill'>Skill</h2>
  <SkillLayout title='Languages' skills={config.programmingLanguages} />
  <SkillLayout title='Backend' skills={config.techSkills} />
</PageLayout>
