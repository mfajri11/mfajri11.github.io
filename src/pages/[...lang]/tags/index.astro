---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/components/custom'

import { useTranslations, useTranslatedPath } from '@/i18n/utils'

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'id' } }
  ]
}

const { lang = 'en' } = Astro.params as { lang?: 'en' | 'id' }
const langLabel = lang === 'en' ? 'English' : 'Bahasa Indonesia'
const t = useTranslations(lang as 'en' | 'id')
const translatePath = useTranslatedPath(lang as 'en' | 'id')

const allPosts = await getBlogCollection()
const langPosts = allPosts.filter((p) => (p.data.language || 'English') === langLabel)
const allTags = getUniqueTagsWithCount(langPosts)

const meta = {
  description: "A list of all the topics I've written about in my posts",
  title: t('nav.tags') as string
}
---

<PageLayout meta={meta as any}>
  <Button title='Back' href={translatePath('/blog')} variant='button'>
    <Icon
      name='back'
      slot='before'
      fill='none'
      strokeWidth='2.5'
      height='16'
      width='16'
      class='stroke-muted-foreground group-hover:stroke-highlight'
    />
  </Button>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{t('nav.tags')}</h1>
    </div>

    <div id='content' class='animate'>
      {
        allTags.length > 0 ? (
          <ul class='flex flex-wrap gap-4'>
            {allTags.map(([tag, val]) => (
              <li>
                <Button
                  href={translatePath(`/tags/${tag}`)}
                  variant='pill'
                  class={cn(
                    'items-start gap-x-1',
                    val > 2 ? 'rounded-xl px-3 py-1 text-xl' : val > 1 && 'text-lg'
                  )}
                >
                  {tag}
                  <span class={val > 2 ? 'text-base' : 'text-xs'}>{val}</span>
                </Button>
              </li>
            ))}
          </ul>
        ) : (
          <p>Any tag yet.</p>
        )
      }
    </div>
  </main>
</PageLayout>
