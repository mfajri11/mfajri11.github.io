---


import { GithubCard } from 'astro-pure/advanced'
import { PostPreview } from '@/components/custom'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/components/custom'
import Avatar from '@/components/home/Avatar.astro'
import CosmicSpace from '@/components/home/CosmicSpace.astro'
// import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import avatarDark from '@/assets/avatar_dark.png'
import avatarLight from '@/assets/avatar.png'
import config from '@/site-config'
import { useTranslations, useTranslatedPath } from '@/i18n/utils'

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'id' } }
  ]
}

const { lang = 'en' } = Astro.params as { lang?: 'en' | 'id' }
const langLabel = lang === 'en' ? 'English' : 'Bahasa Indonesia'
const t = useTranslations(lang as 'en' | 'id')
const translatePath = useTranslatedPath(lang as 'en' | 'id')

const MAX_POSTS = 5
const allPosts = await getBlogCollection()
const langPosts = allPosts.filter((p) => (p.data.language || 'English') === langLabel)
const allPostsByDate = sortMDByDate(langPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#0160C9'>
  <main class='flex w-full flex-col items-center'>
    <CosmicSpace />
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Avatar
        lightSrc={avatarLight}
        darkSrc={avatarDark}
        alt='profile'
        class='h-28 w-28 rounded-full border p-1 overflow-hidden'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title={t('label.location')}>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title={t('label.email')} as='a' href={`mailto:${config.email}`} target='_blank'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
          <Label title={t('label.github')} as='a' href='https://github.com/mfajri11' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title={t('label.linkedin')}
            as='a'
            href='https://id.linkedin.com/in/muhammad-fajri-10a90a19a'
            target='_blank'
          >
            <Icon name='linkedin' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Download CV */}
      <Button
        href='https://drive.google.com/file/d/1MBSrc8Xuxv_w8PTaSxsUMRMP0Aah9It9/view?usp=drivesdk'
        target='_blank'
        title={t('button.downloadCV')}
        variant='button'
      >
        <Icon name='download' slot='before' />
      </Button>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title={t('section.aboutMe')}>
        <p class='text-muted-foreground'>{t('home.greeting')}</p>
        <p class='text-muted-foreground'>
          {t('home.intro')}
        </p>
        <Button title={t('button.moreAboutMe')} class='w-fit self-end' href={translatePath('/about')} variant='ahead' />
      </Section>
      <Section title={t('section.aboutPrintf')}>
        <p class='text-muted-foreground'>
          {t('home.printf')}
        </p>
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title={t('section.posts')}>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title={t('button.morePosts')} class='w-fit self-end' href={translatePath('/blog')} variant='ahead' />
          </Section>
        )
      }

      {/* Projects */}
      <Section title={t('section.projects')}>
        <GithubCard repo='mfajri11/go-family-catering' />
        <GithubCard repo='mfajri11/EfficientNet-AksaraSunda' />
        <Button title={t('button.moreProjects')} class='w-fit self-end' href={translatePath('/projects')} variant='ahead' />
      </Section>

      <Section title={t('section.acknowledgments')}>
        <p class='text-muted-foreground' set:html={t('home.acknowledgments')} />
      </Section>
    </div>
  </main>
</PageLayout>
