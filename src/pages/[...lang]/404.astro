---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { useTranslatedPath } from '@/i18n/utils'

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'id' } }
  ]
}

const { lang = 'en' } = Astro.params as { lang?: 'en' | 'id' }
const translatePath = useTranslatedPath(lang as 'en' | 'id')

const meta = {
  description: 'Not found',
  title: '404'
}
---

<PageLayout meta={meta as any}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>Oops, something went wrong.</p>
    <p class='text-lg'>Sorry, we couldn't find your page.</p>
    <Button title='Back to home' href={translatePath('/')} variant='ahead' class='mt-5' />
  </div>
</PageLayout>
