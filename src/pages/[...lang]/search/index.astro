---
import { PFSearch } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Icon } from '@/components/custom'
import { integ } from '@/site-config'
import { useTranslations, useTranslatedPath } from '@/i18n/utils'

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'id' } }
  ]
}

const { lang = 'en' } = Astro.params as { lang?: 'en' | 'id' }
const t = useTranslations(lang as 'en' | 'id')
const translatePath = useTranslatedPath(lang as 'en' | 'id')

const meta = {
  description: 'Search relative posts of the whole blog',
  title: t('nav.search') as string
}
---

<PageLayout meta={meta as any}>
  <Button title='Back' href={translatePath('/blog')} variant='button'>
    <Icon
      name='back'
      slot='before'
      fill='none'
      strokeWidth='2.5'
      height='16'
      width='16'
      class='stroke-muted-foreground group-hover:stroke-highlight'
    />
  </Button>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{t('nav.search')}</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p>{t('search.description')}</p>
            <PFSearch />
          </>
        ) : (
          <p>{t('search.disabled')}</p>
        )
      }
    </div>
  </main>
</PageLayout>
