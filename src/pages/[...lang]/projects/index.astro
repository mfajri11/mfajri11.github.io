---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import { useTranslations } from '@/i18n/utils'

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'id' } }
  ]
}

const { lang = 'en' } = Astro.params as { lang?: 'en' | 'id' }
const t = useTranslations(lang as 'en' | 'id')

const headings = [
  { depth: 2, slug: 'backends', text: t('projects.backends') },
  { depth: 2, slug: 'personal-blog', text: t('projects.personal_blog') },
  { depth: 2, slug: 'uixs', text: t('projects.ui_ux') },
  { depth: 2, slug: 'learnings', text: t('projects.learnings') }
]
---

<PageLayout title={t('nav.projects')} headings={headings}>
  <h2 id='backends'>{t('projects.backends')}</h2>
  <ProjectSection
    projects={[
      {
        name: 'Go family catering',
        description: 'Backend Service for food ordering management with Go',
        links: [
          { type: 'github', href: 'https://github.com/mfajri11/mfajri11.github.io' },
          { type: 'site', href: 'https://github.com/mfajri11/mfajri11.github.io' },
          {
            type: 'doc',
            href: 'https://github.com/mfajri11/mfajri11.github.io/blob/main/README.md'
          }
        ]
      },
      {
        name: 'Sundanesse script classification',
        description:
          'Image Classification using Transfer Learning with EfficientNetB-0 and PyTorch',
        links: [
          { type: 'github', href: 'https://github.com/mfajri11/EfficientNet-AksaraSunda' },
          { type: 'site', href: 'https://github.com/mfajri11/EfficientNet-AksaraSunda' },
          {
            type: 'doc',
            href: 'https://github.com/mfajri11/EfficientNet-AksaraSunda/blob/main/README.md'
          }
        ]
      }
    ]}
  />

  <h2 id='personal-blog'>{t('projects.personal_blog')}</h2>
  <ProjectSection
    projects={[
      {
        name: 'mfajri11.github.io',
        description: 'This project',
        links: [
          { type: 'github', href: 'https://github.com/mfajri11/mfajri11.github.io' },
          { type: 'site', href: 'https://github.com/mfajri11/mfajri11.github.io' },
          {
            type: 'doc',
            href: 'https://github.com/mfajri11/mfajri11.github.io/blob/main/README.md'
          }
        ]
      }
    ]}
  />

  <h2 id='uixs'>{t('projects.ui_ux')}</h2>
  <ProjectSection
    projects={[
      {
        name: 'Redesign UIX of Recyle with Us — Waste4Change',
        description:
          'Redesign user experience and interface using figma, style guide and component concept',
        links: [
          {
            type: 'site',
            href: 'https://mfajri11.medium.com/ux-case-study-improving-ux-experience-on-waste4change-ef46e60086bc'
          },
          {
            type: 'release',
            href: 'https://www.figma.com/proto/KvgqXN7BRlYTkYiVa3cbOa/SVI--28-4-?embed_host=oembed&kind=proto&node-id=210-1010&scaling=min-zoom&starting-point-node-id=210%3A1010'
          }
        ]
      },
      {
        name: 'Upskill',
        description:
          'Developed gamification features, Seamless user interface, and validation through user testing',
        links: [
          {
            type: 'site',
            href: 'https://mfajri11.medium.com/case-study-an-online-course-platform-be079b571b0c'
          },
          {
            type: 'release',
            href: 'https://www.figma.com/proto/7n0Oa6mP2F5QairVLzR2WC?kind=proto&node-id=302-2838&scaling=scale-down&starting-point-node-id=302:2734'
          }
        ]
      }
    ]}
  />

  <h2 id='learnings'>{t('projects.learnings')}</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'Problem solving using Clojure',
        description:
          'Implemented logic and algorithm problems such recursion and functional abstractions',
        links: [
          {
            type: 'github',
            href: 'https://github.com/mfajri11/4clojure-oxal'
          },
          {
            type: 'site',
            href: 'https://github.com/mfajri11/4clojure-oxal'
          },
          {
            type: 'doc',
            href: 'https://github.com/mfajri11/4clojure-oxal/blob/main/README.md'
          }
        ]
      },
      {
        name: 'Scientific computing with Python',
        description: 'Notes while learning computational thinking using python',
        links: [
          {
            type: 'github',
            href: 'https://github.com/mfajri11/freecodecamp-python'
          },
          {
            type: 'site',
            href: 'https://github.com/mfajri11/freecodecamp-python'
          },
          {
            type: 'doc',
            href: 'https://github.com/mfajri11/freecodecamp-python/blob/main/README.md'
          }
        ]
      }
    ]}
  />
</PageLayout>
